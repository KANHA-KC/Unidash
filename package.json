{
  "name": "unidash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "PORT=3001 node --watch server/index.ts",
    "build": "tsc && vite build",
    "start": "PORT=${PORT:-3000} node server/index.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
